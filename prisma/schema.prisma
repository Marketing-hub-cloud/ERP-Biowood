// Biowood ERP — Prisma schema
// เฟส 1: Foundation (ผู้ใช้, กลุ่มสิทธิ์, audit log, เลขที่เอกสาร, ข้อมูลบริษัท)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── ผู้ใช้งาน ─────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique // เก็บเป็นตัวพิมพ์เล็กเสมอ
  passwordHash String
  firstName    String
  lastName     String
  department   String?
  position     String?
  avatarKey    String?
  isAdmin      Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  statusNote   String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String?

  groups    UserGroup[]
  auditLogs AuditLog[]  @relation("AuditActor")

  receiptsCreated   GoodsReceipt[]  @relation("ReceiptCreatedBy")
  receiptsPosted    GoodsReceipt[]  @relation("ReceiptPostedBy")
  receiptsCancelled GoodsReceipt[]  @relation("ReceiptCancelledBy")
  issuesCreated     GoodsIssue[]    @relation("IssueCreatedBy")
  issuesPosted      GoodsIssue[]    @relation("IssuePostedBy")
  issuesCancelled   GoodsIssue[]    @relation("IssueCancelledBy")
  movements         StockMovement[] @relation("MovementCreatedBy")

  prRequested     PurchaseRequest[]      @relation("PrRequester")
  prCreated       PurchaseRequest[]      @relation("PrCreatedBy")
  prCancelled     PurchaseRequest[]      @relation("PrCancelledBy")
  poCreated       PurchaseOrder[]        @relation("PoCreatedBy")
  poCancelled     PurchaseOrder[]        @relation("PoCancelledBy")
  rtCreated       PurchaseReturn[]       @relation("RtCreatedBy")
  rtCancelled     PurchaseReturn[]       @relation("RtCancelledBy")
  approvalSteps   ApprovalStepApprover[] @relation("ApprovalStepUser")
  approvalActions ApprovalAction[]       @relation("ApprovalActionActor")
  notifications   Notification[]

  engineerAssigned     EngineerDoc[]         @relation("EngineerAssignee")
  engineerCreated      EngineerDoc[]         @relation("EngineerCreatedBy")
  engineerCancelled    EngineerDoc[]         @relation("EngineerCancelledBy")
  engineerParticipants EngineerParticipant[] @relation("EngineerParticipantUser")
  engineerFiles        EngineerFile[]        @relation("EngineerFileUploadedBy")
  engineerStepLogs     EngineerStepLog[]     @relation("EngineerStepActor")
  projectsAsSalesRep   Project[]             @relation("ProjectSalesRep")
  projectsCreated      Project[]             @relation("ProjectCreatedBy")
  workPlans            WorkPlan[]            @relation("WorkPlanEmployee")
  workPlansCreated     WorkPlan[]            @relation("WorkPlanCreatedBy")

  @@map("users")
}

// ───────────────────────── กำหนดสิทธิ์ ─────────────────────────

model PermissionGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions GroupPermission[]
  members     UserGroup[]

  @@map("permission_groups")
}

model GroupPermission {
  groupId    String
  menuKey    String // ดูรายการเมนูใน src/lib/menu.ts
  canView    Boolean @default(false)
  canCreate  Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)
  canCancel  Boolean @default(false)
  canApprove Boolean @default(false)

  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, menuKey])
  @@map("group_permissions")
}

model UserGroup {
  userId  String
  groupId String

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

// ───────────────────────── Audit log ─────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVE
  REJECT
  CANCEL
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     AuditAction
  before     Json?
  after      Json?
  changes    Json? // { field: [old, new] }
  note       String?
  ip         String?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────── เลขที่เอกสาร ─────────────────────────

model DocumentCounter {
  prefix  String
  dateKey String // YYMMDD ตามเวลา Asia/Bangkok
  lastSeq Int    @default(0)

  @@id([prefix, dateKey])
  @@map("document_counters")
}

// ───────────────────────── ข้อมูลบริษัท ─────────────────────────

model CompanySetting {
  id        Int      @id @default(1) // singleton
  nameTh    String
  nameEn    String?
  address   String?
  taxId     String?  @db.VarChar(13)
  branch    String?
  phone     String?
  email     String?
  website   String?
  logoKey   String?
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ───────────────────────── ผู้ติดต่อ (เฟส 2) ─────────────────────────

enum EntityType {
  JURISTIC // นิติบุคคล
  INDIVIDUAL // บุคคลธรรมดา
}

enum ChannelType {
  PHONE
  MOBILE
  EMAIL
  LINE
  FACEBOOK
  WEBSITE
  FAX
  OTHER
}

enum LookupKind {
  CONTACT_SOURCE // ช่องทางที่รู้จัก
  CUSTOMER_BUSINESS_TYPE // ประเภทกิจการของลูกค้า
  PRODUCT_TYPE // ประเภทสินค้า
  RETURN_REASON // เหตุผลการส่งคืนสินค้า (จัดซื้อ)
  PROJECT_WORK_STAGE // ขั้นตอนของงาน (โครงการ)
  PROJECT_WORK_NATURE // ลักษณะงาน (โครงการ)
}

model Contact {
  id                     String     @id @default(cuid())
  code                   String     @unique // CT00001 (สร้างอัตโนมัติ แก้ได้)
  isCustomer             Boolean    @default(false)
  isVendor               Boolean    @default(false)
  entityType             EntityType @default(JURISTIC)
  name                   String
  taxId                  String?    @db.VarChar(13)
  branch                 String?
  sourceId               String?
  customerBusinessTypeId String?
  photoKey               String?
  note                   String?

  // ที่อยู่จดทะเบียน
  regAddress     String?
  regHouseNo     String?
  regMoo         String?
  regSoi         String?
  regRoad        String?
  regSubdistrict String?
  regDistrict    String?
  regProvince    String?
  regPostalCode  String? @db.VarChar(10)
  regCountry     String  @default("ไทย")

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  source               LookupOption?    @relation("ContactSource", fields: [sourceId], references: [id])
  customerBusinessType LookupOption?    @relation("ContactBusinessType", fields: [customerBusinessTypeId], references: [id])
  shippingAddresses    ContactAddress[]
  channels             ContactChannel[]
  persons              ContactPerson[]
  tags                 ContactTag[]
  goodsIssues          GoodsIssue[]
  purchaseOrders       PurchaseOrder[]  @relation("PoVendor")
  purchaseReturns      PurchaseReturn[] @relation("RtVendor")
  engineerDocs         EngineerDoc[]    @relation("EngineerCustomer")
  projects             Project[]        @relation("ProjectCustomer")
  workPlans            WorkPlan[]       @relation("WorkPlanCustomer")

  @@index([isCustomer, deletedAt])
  @@index([isVendor, deletedAt])
  @@index([name])
  @@map("contacts")
}

model ContactAddress {
  id          String  @id @default(cuid())
  contactId   String
  label       String?
  recipient   String?
  phone       String?
  address     String?
  houseNo     String?
  moo         String?
  soi         String?
  road        String?
  subdistrict String?
  district    String?
  province    String?
  postalCode  String? @db.VarChar(10)
  country     String  @default("ไทย")
  isDefault   Boolean @default(false)
  sortOrder   Int     @default(0)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_addresses")
}

model ContactChannel {
  id        String      @id @default(cuid())
  contactId String
  type      ChannelType
  value     String
  note      String?
  sortOrder Int         @default(0)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([value])
  @@map("contact_channels")
}

model ContactPerson {
  id        String  @id @default(cuid())
  contactId String
  name      String
  position  String?
  phone     String?
  email     String?
  lineId    String?
  note      String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_persons")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  contacts ContactTag[]
  projects ProjectTag[]

  @@map("tags")
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model LookupOption {
  id        String     @id @default(cuid())
  kind      LookupKind
  label     String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  contactsAsSource       Contact[]        @relation("ContactSource")
  contactsAsBusinessType Contact[]        @relation("ContactBusinessType")
  products               Product[]        @relation("ProductType")
  purchaseReturns        PurchaseReturn[] @relation("ReturnReason")
  projectsAsBusinessType Project[]        @relation("ProjectBusinessType")
  projectsAsWorkStage    Project[]        @relation("ProjectWorkStage")
  projectsAsWorkNature   Project[]        @relation("ProjectWorkNature")

  @@unique([kind, label])
  @@map("lookup_options")
}

// ───────────────────────── ตั้งค่าคลัง + สินค้า (เฟส 3) ─────────────────────────

enum AttributeType {
  TEXT
  NUMBER
  SELECT
}

/// คลัง (level 0) + สถานที่ย่อย (level 1–3) เช่น โซน > ชั้น > ช่อง
model StockLocation {
  id        String   @id @default(cuid())
  parentId  String?
  level     Int
  code      String
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   StockLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children StockLocation[] @relation("LocationTree")

  receipts           GoodsReceipt[]     @relation("ReceiptWarehouse")
  receiptLines       GoodsReceiptLine[] @relation("ReceiptLineLocation")
  serialsWarehouse   StockSerial[]      @relation("SerialWarehouse")
  serialsLocation    StockSerial[]      @relation("SerialLocation")
  movementsWarehouse StockMovement[]    @relation("MovementWarehouse")
  movementsLocation  StockMovement[]    @relation("MovementLocation")
  purchaseRequests   PurchaseRequest[]  @relation("PrWarehouse")
  purchaseOrders     PurchaseOrder[]    @relation("PoWarehouse")

  @@unique([parentId, code])
  @@index([parentId])
  @@map("stock_locations")
}

/// หมวดหมู่สินค้า level 1–3
model ProductCategory {
  id        String   @id @default(cuid())
  parentId  String?
  level     Int
  code      String?
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, name])
  @@index([parentId])
  @@map("product_categories")
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@map("units")
}

model ProductAttribute {
  id         String        @id @default(cuid())
  name       String        @unique
  dataType   AttributeType
  options    String[]
  unitLabel  String?
  isRequired Boolean       @default(false)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  values ProductAttributeValue[]

  @@map("product_attributes")
}

model Product {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  productTypeId String?
  categoryId    String?
  description   String?
  isStockable   Boolean   @default(true)
  stockUnitId   String?
  isActive      Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  productType     LookupOption?           @relation("ProductType", fields: [productTypeId], references: [id])
  category        ProductCategory?        @relation(fields: [categoryId], references: [id])
  stockUnit       Unit?                   @relation(fields: [stockUnitId], references: [id])
  images          ProductImage[]
  attributeValues ProductAttributeValue[]
  receiptLines    GoodsReceiptLine[]
  issueLines      GoodsIssueLine[]
  serials         StockSerial[]
  movements       StockMovement[]
  prLines         PurchaseRequestLine[]
  poLines         PurchaseOrderLine[]
  rtLines         PurchaseReturnLine[]
  estimateLines   EngineerEstimateLine[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  key       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductAttributeValue {
  productId   String
  attributeId String
  value       String

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id])

  @@id([productId, attributeId])
  @@index([attributeId])
  @@map("product_attribute_values")
}

// ───────────────────────── เฟส 4: นำเข้า / นำออก / Stock ledger ─────────────────────────

enum GoodsReceiptType {
  PURCHASE // สั่งซื้อ (อ้างอิง PO — เปิดใช้ในเฟส 5)
  OTHER // อื่นๆ
}

enum GoodsIssueType {
  SALE // ขาย
  RETURN // ส่งคืน (อ้างอิงใบส่งคืน — เปิดใช้ในเฟส 5)
  SAMPLE // เบิกตัวอย่าง
  OTHER // อื่นๆ
}

enum StockDocStatus {
  DRAFT // ร่าง
  POSTED // นำเข้าแล้ว / นำออกแล้ว
  CANCELLED // ยกเลิก
}

enum MovementType {
  RECEIPT
  ISSUE
  RECEIPT_REVERSAL // ยกเลิกใบนำเข้าที่นำเข้าแล้ว
  ISSUE_REVERSAL // ยกเลิกใบนำออกที่นำออกแล้ว
}

/// ใบนำเข้า (GR)
model GoodsReceipt {
  id              String           @id @default(cuid())
  docNo           String           @unique
  type            GoodsReceiptType @default(OTHER)
  docDate         DateTime         @db.Date
  warehouseId     String
  purchaseOrderId String? // ประเภท "สั่งซื้อ"
  lot             String?
  note            String?
  status          StockDocStatus   @default(DRAFT)
  postedAt        DateTime?
  postedById      String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelReason    String?
  createdById     String
  updatedById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  warehouse   StockLocation      @relation("ReceiptWarehouse", fields: [warehouseId], references: [id])
  createdBy   User               @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  postedBy    User?              @relation("ReceiptPostedBy", fields: [postedById], references: [id])
  cancelledBy User?              @relation("ReceiptCancelledBy", fields: [cancelledById], references: [id])
  lines       GoodsReceiptLine[]
  order       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])

  @@index([status, docDate])
  @@index([warehouseId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String  @id @default(cuid())
  receiptId   String
  lineNo      Int
  productId   String
  locationId  String? // ต้องเลือกก่อนกด "นำเข้า"
  orderLineId String? // รายการ PO ที่รับ (ประเภท "สั่งซื้อ")
  note        String?

  orderLine PurchaseOrderLine? @relation(fields: [orderLineId], references: [id])
  receipt   GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id])
  location  StockLocation?     @relation("ReceiptLineLocation", fields: [locationId], references: [id])
  serials   StockSerial[]

  @@index([receiptId])
  @@index([productId])
  @@map("goods_receipt_lines")
}

/// Barcode / SN 1 ชิ้น (สร้างจากใบนำเข้า)
model StockSerial {
  id            String    @id @default(cuid())
  barcode       String    @unique // GR2611240001-001
  seq           Int // ลำดับภายในใบนำเข้า
  productId     String
  receiptLineId String
  initialQty    Decimal   @db.Decimal(14, 3)
  // คัดลอกตอนกด "นำเข้า" (ใช้ค้นหา/รายงาน)
  warehouseId   String?
  locationId    String?
  lot           String?
  scannedAt     DateTime?
  scannedById   String?
  createdAt     DateTime  @default(now())

  product     Product          @relation(fields: [productId], references: [id])
  receiptLine GoodsReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)
  warehouse   StockLocation?   @relation("SerialWarehouse", fields: [warehouseId], references: [id])
  location    StockLocation?   @relation("SerialLocation", fields: [locationId], references: [id])
  movements   StockMovement[]
  issueLines  GoodsIssueLine[]

  @@index([receiptLineId])
  @@index([productId])
  @@map("stock_serials")
}

/// ใบนำออก (GI)
model GoodsIssue {
  id               String         @id @default(cuid())
  docNo            String         @unique
  type             GoodsIssueType
  docDate          DateTime       @db.Date
  contactId        String?
  purchaseReturnId String? // ประเภท "ส่งคืน"
  recipientName    String?
  shippingAddress  String?
  note             String?
  status           StockDocStatus @default(DRAFT)
  postedAt         DateTime?
  postedById       String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  createdById      String
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  contact        Contact?         @relation(fields: [contactId], references: [id])
  createdBy      User             @relation("IssueCreatedBy", fields: [createdById], references: [id])
  postedBy       User?            @relation("IssuePostedBy", fields: [postedById], references: [id])
  cancelledBy    User?            @relation("IssueCancelledBy", fields: [cancelledById], references: [id])
  lines          GoodsIssueLine[]
  purchaseReturn PurchaseReturn?  @relation(fields: [purchaseReturnId], references: [id])

  @@index([status, docDate])
  @@index([contactId])
  @@map("goods_issues")
}

model GoodsIssueLine {
  id           String  @id @default(cuid())
  issueId      String
  lineNo       Int
  serialId     String
  productId    String
  quantity     Decimal @db.Decimal(14, 3)
  returnLineId String? // รายการใบส่งคืน (ประเภท "ส่งคืน")
  note         String?

  returnLine PurchaseReturnLine? @relation(fields: [returnLineId], references: [id])
  issue      GoodsIssue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  serial     StockSerial         @relation(fields: [serialId], references: [id])
  product    Product             @relation(fields: [productId], references: [id])

  @@unique([issueId, serialId])
  @@index([serialId])
  @@map("goods_issue_lines")
}

/// Stock ledger — เพิ่มอย่างเดียว ห้ามแก้/ลบ ยอดคงคลังคำนวณจากตารางนี้เท่านั้น
model StockMovement {
  id          String       @id @default(cuid())
  type        MovementType
  productId   String
  warehouseId String
  locationId  String?
  serialId    String
  lot         String?
  quantity    Decimal      @db.Decimal(14, 3) // + เข้า / − ออก
  refType     String // "GR" | "GI"
  refId       String
  refLineId   String?
  refDocNo    String
  occurredAt  DateTime     @default(now())
  createdById String
  createdAt   DateTime     @default(now())

  product   Product        @relation(fields: [productId], references: [id])
  warehouse StockLocation  @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  location  StockLocation? @relation("MovementLocation", fields: [locationId], references: [id])
  serial    StockSerial    @relation(fields: [serialId], references: [id])
  createdBy User           @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId])
  @@index([serialId])
  @@index([warehouseId, locationId])
  @@index([refType, refId])
  @@index([occurredAt])
  @@map("stock_movements")
}

// ───────────────────────── เฟส 5: จัดซื้อ + Approval engine ─────────────────────────

/// สถานะเอกสารที่ผ่าน approval engine
/// PARTIAL/COMPLETED แสดงตามชนิด: PR สั่งซื้อแล้ว(บางส่วน), PO นำเข้าแล้ว(บางส่วน), RT ส่งคืนแล้ว(บางส่วน)
enum PurchaseStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIAL
  COMPLETED
  CANCELLED
}

enum VatMode {
  EXCLUSIVE // แยกนอก
  INCLUSIVE // รวมใน
  NONE // ไม่มี VAT
}

enum ApprovalActionType {
  SUBMIT
  APPROVE
  REJECT
  CANCEL
}

/// ผังอนุมัติ: docType "PR" | "PO" | "RT" (ใช้กับโมดูลอื่นได้) ลำดับ 1..3
model ApprovalStep {
  id      String @id @default(cuid())
  docType String
  stepNo  Int

  approvers ApprovalStepApprover[]

  @@unique([docType, stepNo])
  @@map("approval_steps")
}

model ApprovalStepApprover {
  stepId String
  userId String

  step ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user User         @relation("ApprovalStepUser", fields: [userId], references: [id])

  @@id([stepId, userId])
  @@map("approval_step_approvers")
}

/// ประวัติการส่ง/อนุมัติ/ไม่อนุมัติ/ยกเลิก ของเอกสาร (อ้างด้วย docType + docId)
model ApprovalAction {
  id        String             @id @default(cuid())
  docType   String
  docId     String
  round     Int
  stepNo    Int?
  action    ApprovalActionType
  actorId   String
  comment   String?
  createdAt DateTime           @default(now())

  actor User @relation("ApprovalActionActor", fields: [actorId], references: [id])

  @@index([docType, docId])
  @@map("approval_actions")
}

/// ใบขอซื้อ (PR)
model PurchaseRequest {
  id               String         @id @default(cuid())
  docNo            String         @unique
  status           PurchaseStatus @default(DRAFT)
  docDate          DateTime       @db.Date
  requiredDate     DateTime?      @db.Date
  requesterId      String
  department       String?
  position         String?
  reference        String?
  warehouseId      String?
  note             String?
  // approval
  approvalSnapshot Json?
  currentStep      Int?
  approvalRound    Int            @default(0)
  submittedAt      DateTime?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  createdById      String
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  requester   User                  @relation("PrRequester", fields: [requesterId], references: [id])
  createdBy   User                  @relation("PrCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?                 @relation("PrCancelledBy", fields: [cancelledById], references: [id])
  warehouse   StockLocation?        @relation("PrWarehouse", fields: [warehouseId], references: [id])
  lines       PurchaseRequestLine[]

  @@index([status, docDate])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id        String  @id @default(cuid())
  requestId String
  lineNo    Int
  productId String
  quantity  Decimal @db.Decimal(14, 3)
  note      String?

  request    PurchaseRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id])
  orderLines PurchaseOrderLine[]

  @@index([requestId])
  @@map("purchase_request_lines")
}

/// ใบสั่งซื้อ (PO)
model PurchaseOrder {
  id               String         @id @default(cuid())
  docNo            String         @unique
  status           PurchaseStatus @default(DRAFT)
  docDate          DateTime       @db.Date
  deliveryDate     DateTime?      @db.Date
  vendorId         String
  paymentTerms     String?
  reference        String?
  warehouseId      String?
  note             String?
  vatMode          VatMode        @default(EXCLUSIVE)
  vatRate          Decimal        @default(7) @db.Decimal(5, 2)
  headerDiscount   Decimal        @default(0) @db.Decimal(14, 2)
  // คำนวณที่ server แล้วเก็บไว้ (ดู src/lib/purchase-calc.ts)
  subtotal         Decimal        @default(0) @db.Decimal(14, 2)
  vatAmount        Decimal        @default(0) @db.Decimal(14, 2)
  total            Decimal        @default(0) @db.Decimal(14, 2)
  // approval
  approvalSnapshot Json?
  currentStep      Int?
  approvalRound    Int            @default(0)
  submittedAt      DateTime?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  createdById      String
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  vendor      Contact             @relation("PoVendor", fields: [vendorId], references: [id])
  createdBy   User                @relation("PoCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?               @relation("PoCancelledBy", fields: [cancelledById], references: [id])
  warehouse   StockLocation?      @relation("PoWarehouse", fields: [warehouseId], references: [id])
  lines       PurchaseOrderLine[]
  receipts    GoodsReceipt[]
  returns     PurchaseReturn[]

  @@index([status, docDate])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id            String  @id @default(cuid())
  orderId       String
  lineNo        Int
  productId     String
  requestLineId String?
  quantity      Decimal @db.Decimal(14, 3)
  unitPrice     Decimal @db.Decimal(14, 4)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  amount        Decimal @db.Decimal(14, 2)
  note          String?

  order        PurchaseOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id])
  requestLine  PurchaseRequestLine? @relation(fields: [requestLineId], references: [id])
  receiptLines GoodsReceiptLine[]
  returnLines  PurchaseReturnLine[]

  @@index([orderId])
  @@index([requestLineId])
  @@map("purchase_order_lines")
}

/// ใบส่งคืน (RT) — คืนสินค้าให้ผู้ขาย สร้างจาก PO
model PurchaseReturn {
  id               String         @id @default(cuid())
  docNo            String         @unique
  status           PurchaseStatus @default(DRAFT)
  docDate          DateTime       @db.Date
  orderId          String
  vendorId         String
  reasonId         String
  note             String?
  // approval
  approvalSnapshot Json?
  currentStep      Int?
  approvalRound    Int            @default(0)
  submittedAt      DateTime?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  createdById      String
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order       PurchaseOrder        @relation(fields: [orderId], references: [id])
  vendor      Contact              @relation("RtVendor", fields: [vendorId], references: [id])
  reason      LookupOption         @relation("ReturnReason", fields: [reasonId], references: [id])
  createdBy   User                 @relation("RtCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?                @relation("RtCancelledBy", fields: [cancelledById], references: [id])
  lines       PurchaseReturnLine[]
  issues      GoodsIssue[]

  @@index([status, docDate])
  @@index([orderId])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id          String  @id @default(cuid())
  returnId    String
  lineNo      Int
  orderLineId String
  productId   String
  quantity    Decimal @db.Decimal(14, 3)
  note        String?

  purchaseReturn PurchaseReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine      PurchaseOrderLine @relation(fields: [orderLineId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
  issueLines     GoodsIssueLine[]

  @@index([returnId])
  @@index([orderLineId])
  @@map("purchase_return_lines")
}

/// หมายเหตุสำเร็จรูป แยกตามโมดูล (เช่น "purchase")
model NoteTemplate {
  id        String   @id @default(cuid())
  module    String
  title     String
  body      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@map("note_templates")
}

// ───────────────────────── เฟส 6: แจ้งเตือน (ในระบบ + LINE) ─────────────────────────

/// แจ้งเตือนในระบบ (ไอคอนกระดิ่ง)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  module    String // "purchase" | "engineer"
  title     String
  body      String?
  link      String?
  docType   String?
  docId     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// ตั้งค่าการแจ้งเตือนต่อโมดูล (token อยู่ใน env เท่านั้น)
model NotificationSetting {
  module        String   @id
  lineEnabled   Boolean  @default(false)
  lineGroupId   String?
  lineGroupName String?
  updatedById   String?
  updatedAt     DateTime @updatedAt

  @@map("notification_settings")
}

/// กลุ่ม LINE ที่บอทเข้าร่วม (บันทึกจาก webhook)
model LineGroup {
  groupId  String    @id
  name     String?
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@map("line_groups")
}

enum DeliveryStatus {
  PENDING // รอส่ง
  SENDING // กำลังส่ง (worker จองไว้)
  SENT // ส่งแล้ว
  FAILED // ส่งไม่สำเร็จ (ครบจำนวนครั้ง หรือผิดถาวร)
}

/// คิวส่ง LINE (outbox) — เขียนใน transaction เดียวกับเอกสาร แล้ว worker ส่งทีหลัง
model NotificationDelivery {
  id            String         @id @default(cuid())
  channel       String         @default("LINE")
  module        String
  target        String // groupId
  message       String
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lockedAt      DateTime?
  lastError     String?
  sentAt        DateTime?
  refType       String?
  refId         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("notification_deliveries")
}

// ───────────────────────── เฟส 7: ถอดแบบ/ติดตั้ง ─────────────────────────

/// ขั้นของใบถอดแบบ/ติดตั้ง (state machine ดู src/lib/engineer-workflow.ts)
enum EngineerStatus {
  DRAFT // 1 ร่าง
  NEW // 2 งานถอดแบบใหม่
  REVIEWED // 3 ตรวจสอบแล้ว
  QUEUED // 4 รับลงคิว
  ASSIGNED // 5 มอบหมาย
  IN_PROGRESS // 6 ดำเนินงาน
  INSPECTION // 7 ตรวจรับงาน
  ESTIMATE // 8 ใบสรุปประมาณถอดแบบ
  COMPLETED // 9 เสร็จสิ้น
  CANCELLED // ยกเลิก
}

enum EngineerWorkType {
  SURVEY // ถอดแบบ
  INSTALL // ติดตั้ง
  CHANGE // งานเพิ่ม/ลด
}

enum EngineerUrgency {
  NORMAL // ทั่วไป
  URGENT // ด่วน
}

enum EngineerFileKind {
  CUSTOMER_DRAWING // แบบจากลูกค้า
  RETURN_DOC // เอกสารส่งกลับ (ผลงานถอดแบบ)
}

/// ใบถอดแบบ/ติดตั้ง (EN)
model EngineerDoc {
  id            String             @id @default(cuid())
  docNo         String             @unique
  status        EngineerStatus     @default(DRAFT)
  docDate       DateTime           @db.Date // วันที่ออกเอกสาร
  startDate     DateTime?          @db.Date // วันที่เริ่มงาน
  dueDate       DateTime?          @db.Date // วันที่กำหนดส่ง
  revision      Int                @default(1) // ครั้งที่
  workTypes     EngineerWorkType[]
  workDetail    String? // ข้อมูลลักษณะงาน
  projectName   String
  urgency       EngineerUrgency    @default(NORMAL)
  customerId    String?
  addressLabel  String? // ที่อยู่ที่เลือก เช่น "ที่อยู่จดทะเบียน"
  siteAddress   String? // ข้อความที่อยู่ (คัดลอกจากผู้ติดต่อ แก้ต่อได้)
  assigneeId    String? // ผู้รับผิดชอบงาน (ขั้น "มอบหมาย")
  projectId     String? // โครงการ CRM (เฟส 8)
  note          String?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  createdById   String
  updatedById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer      Contact?               @relation("EngineerCustomer", fields: [customerId], references: [id])
  project       Project?               @relation(fields: [projectId], references: [id])
  assignee      User?                  @relation("EngineerAssignee", fields: [assigneeId], references: [id])
  createdBy     User                   @relation("EngineerCreatedBy", fields: [createdById], references: [id])
  cancelledBy   User?                  @relation("EngineerCancelledBy", fields: [cancelledById], references: [id])
  participants  EngineerParticipant[]
  files         EngineerFile[]
  estimateLines EngineerEstimateLine[]
  stepLogs      EngineerStepLog[]

  @@index([status, docDate])
  @@index([customerId])
  @@index([projectId])
  @@index([assigneeId])
  @@map("engineer_docs")
}

/// ผู้เกี่ยวข้อง (หลายคน)
model EngineerParticipant {
  docId  String
  userId String

  doc  EngineerDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  user User        @relation("EngineerParticipantUser", fields: [userId], references: [id])

  @@id([docId, userId])
  @@index([userId])
  @@map("engineer_participants")
}

/// ไฟล์แนบ: แบบจากลูกค้า / เอกสารส่งกลับ
model EngineerFile {
  id           String           @id @default(cuid())
  docId        String
  kind         EngineerFileKind
  key          String // storage key
  fileName     String
  contentType  String
  size         Int
  uploadedById String
  createdAt    DateTime         @default(now())

  doc        EngineerDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation("EngineerFileUploadedBy", fields: [uploadedById], references: [id])

  @@index([docId])
  @@map("engineer_files")
}

/// ใบสรุปประมาณถอดแบบ: รายการสินค้าและปริมาณที่ประมาณได้
model EngineerEstimateLine {
  id        String  @id @default(cuid())
  docId     String
  lineNo    Int
  productId String
  quantity  Decimal @db.Decimal(14, 3)
  note      String?

  doc     EngineerDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@index([docId])
  @@map("engineer_estimate_lines")
}

/// ประวัติการเปลี่ยนขั้น (ทุกขั้นมีบันทึก)
model EngineerStepLog {
  id         String          @id @default(cuid())
  docId      String
  fromStatus EngineerStatus?
  toStatus   EngineerStatus
  actorId    String
  comment    String?
  createdAt  DateTime        @default(now())

  doc   EngineerDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  actor User        @relation("EngineerStepActor", fields: [actorId], references: [id])

  @@index([docId, createdAt])
  @@map("engineer_step_logs")
}

// ───────────────────────── เฟส 8: CRM ─────────────────────────

/// สถานะโครงการ (stepper แนวนอน)
enum ProjectStatus {
  NEW // โครงการใหม่
  IN_PROGRESS // กำลังดำเนินการ
  QUOTED // เสนอราคา
  WON // ปิดได้
  CLOSED // จบโครงการ
  AFTERCARE // ดูแลงาน
  ENGINEERING // ถอดแบบ/ติดตั้ง
  SHIPPING // ขนส่ง
  PAYMENT // ชำระเงิน
}

/// โครงการ (CRM)
model Project {
  id                String        @id @default(cuid())
  name              String
  status            ProjectStatus @default(NEW)
  customerId        String
  contactPerson     String? // บุคคลติดต่อ (คัดลอกชื่อจากผู้ติดต่อ — บุคคลติดต่อถูกสร้างใหม่ทุกครั้งที่แก้ผู้ติดต่อ)
  salesRepId        String? // พนักงานขายผู้รับผิดชอบ
  businessTypeId    String? // ประเภทกิจการ (เช่น บ้านส่วนตัว)
  workStageId       String? // ขั้นตอนของงาน (เช่น ก่อสร้าง)
  workNatureId      String? // ลักษณะงาน (เช่น เทียบสเปค)
  workDetail        String? // ข้อมูลลักษณะงาน
  probability       Int? // % โอกาสสำเร็จ 10–100
  expectedCloseDate DateTime?     @db.Date
  value             Decimal?      @db.Decimal(14, 2)
  warrantyStart     DateTime?     @db.Date
  warrantyEnd       DateTime?     @db.Date
  warrantyNote      String?
  note              String?
  createdById       String
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  customer     Contact       @relation("ProjectCustomer", fields: [customerId], references: [id])
  salesRep     User?         @relation("ProjectSalesRep", fields: [salesRepId], references: [id])
  createdBy    User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  businessType LookupOption? @relation("ProjectBusinessType", fields: [businessTypeId], references: [id])
  workStage    LookupOption? @relation("ProjectWorkStage", fields: [workStageId], references: [id])
  workNature   LookupOption? @relation("ProjectWorkNature", fields: [workNatureId], references: [id])
  tags         ProjectTag[]
  engineerDocs EngineerDoc[]
  workPlans    WorkPlan[]

  @@index([customerId, deletedAt])
  @@index([salesRepId])
  @@index([status])
  @@map("projects")
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

enum WorkPlanStatus {
  PLANNED // วางแผน
  CHECKED_IN // เช็คอิน
  DONE // เสร็จสิ้น
  CANCELLED // ยกเลิก
}

/// แผนการทำงาน (นัดหมาย/เยี่ยมลูกค้า) + เช็คอิน GPS
model WorkPlan {
  id           String         @id @default(cuid())
  subject      String
  status       WorkPlanStatus @default(PLANNED)
  plannedStart DateTime
  plannedEnd   DateTime
  employeeId   String
  customerId   String?
  projectId    String?
  location     String?
  detail       String?

  // เช็คอิน จุดเริ่มต้น / จุดหมาย (เวลาใช้เวลาของ server)
  startLat       Decimal?  @db.Decimal(9, 6)
  startLng       Decimal?  @db.Decimal(9, 6)
  startAccuracy  Int? // เมตร
  startAt        DateTime?
  endLat         Decimal?  @db.Decimal(9, 6)
  endLng         Decimal?  @db.Decimal(9, 6)
  endAccuracy    Int?
  endAt          DateTime?
  distanceKm     Decimal?  @db.Decimal(10, 3)
  distanceSource String? // "haversine" | "google"

  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdById  String
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee  User     @relation("WorkPlanEmployee", fields: [employeeId], references: [id])
  createdBy User     @relation("WorkPlanCreatedBy", fields: [createdById], references: [id])
  customer  Contact? @relation("WorkPlanCustomer", fields: [customerId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([employeeId, plannedStart])
  @@index([plannedStart])
  @@index([projectId])
  @@map("work_plans")
}
