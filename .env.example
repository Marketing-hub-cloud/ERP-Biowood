# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้าม commit .env)

# ── Database (Supabase) ──
# Project Settings > Database > Connection string
# แอปตอนรัน: Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Migration (prisma migrate): Session pooler หรือ Direct connection (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Auth.js ──
# สร้างด้วย: npx auth secret  หรือ  openssl rand -base64 32
AUTH_SECRET=""

# ── Seed ──
SEED_ADMIN_EMAIL="admin@biowood.local"
SEED_ADMIN_PASSWORD=""

# ── File storage (dev = local disk) ──
UPLOAD_DIR="./uploads"

# ── E2E tests (Playwright) ──
E2E_BASE_URL="http://localhost:3000"

# ── แจ้งเตือน LINE (Messaging API) — ค่าลับ ห้าม commit ──
# LINE Developers > Provider > Messaging API channel
# Channel access token (long-lived) ใช้ส่งข้อความ
LINE_CHANNEL_ACCESS_TOKEN=""
# Basic settings > Channel secret ใช้ตรวจลายเซ็น webhook
LINE_CHANNEL_SECRET=""
# URL ของระบบ (ใช้ทำลิงก์เข้าเอกสารในข้อความ LINE และ webhook)
APP_BASE_URL="http://localhost:3000"
# ปิด worker ในแอป (ถ้าใช้ cron ภายนอกเรียก POST /api/jobs/notifications แทน)
# NOTIFY_WORKER="off"
# secret สำหรับ cron ภายนอก (อย่างน้อย 16 ตัวอักษร) ส่งเป็น Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=""

# ── Dev server ──
# เปิดผ่าน IP วงแลน (192.168.x.x / 10.x.x.x / 172.x.x.x) ได้อยู่แล้ว
# ถ้าเปิดผ่านโดเมน/tunnel อื่นตอน `npm run dev` ให้ใส่ hostname ที่นี่ (คั่นด้วย comma) แล้วรัน dev ใหม่
# DEV_ALLOWED_ORIGINS="my-pc.local,*.trycloudflare.com"
