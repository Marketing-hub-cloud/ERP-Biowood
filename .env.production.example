# Production — คัดลอกเป็น .env.production บนเซิร์ฟเวอร์ แล้วกรอกค่า (ห้าม commit)
# ดู docs/DEPLOY.md

# ── Database (Supabase) ──
# แอป: Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# migrate: Session pooler หรือ Direct (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Auth.js ── สร้างใหม่สำหรับ production: openssl rand -base64 32
AUTH_SECRET=""
# URL จริงของระบบ (https)
AUTH_URL="https://erp.example.com"
APP_BASE_URL="https://erp.example.com"

# ── Seed (ครั้งแรก) ── รหัสผ่าน admin ตั้งให้ยาก แล้วเปลี่ยนในระบบหลังล็อกอินครั้งแรก
SEED_ADMIN_EMAIL="admin@biowood.co.th"
SEED_ADMIN_PASSWORD=""
# ไม่สร้างข้อมูลตัวอย่าง (ผู้ติดต่อ/คลัง/สินค้า/ใบนำเข้าตัวอย่าง)
SEED_SAMPLE_DATA="false"

# ── LINE Messaging API ──
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
